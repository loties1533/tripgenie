{
  "name": "tripgenie",
  "version": "1.0.0",
  "type": "module",
  "description": "AI Travel Curator — plans clé en main via scoring multi-critères",
  "main": "dist-server/index.js",
  "scripts": {
    "start": "node dist-server/index.js",
    "dev": "nodemon --exec tsx server/index.ts",
    "build:server": "npx tsc",
    "setup-db": "node scripts/setup-db.js",
    "client:dev": "cd client-react && npm run dev",
    "build": "cd client-react && npm install && npm run build",
    "client:build": "cd client-react && npm run build",
    "test": "vitest run tests/api.test.ts tests/golden_path.test.ts tests/scoring.test.ts tests/middleware.test.ts",
    "test:vitest": "vitest run tests/api.test.ts",
    "test:scoring": "vitest run tests/scoring.test.ts",
    "test:middleware": "vitest run tests/middleware.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.8.0",
    "jsdom": "^29.0.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
