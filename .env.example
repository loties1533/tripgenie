# =============================================
# TRIPGENIE — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# Ne JAMAIS committer le .env sur GitHub !
# =============================================

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (génère avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Supabase (base de données + auth) ----
# Gratuit sur supabase.com
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ---- Claude / Anthropic ----
# Clé sur console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxx

# ---- Amadeus (vols réels) ----
# Gratuit en sandbox sur developers.amadeus.com
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ---- PredictHQ (événements) ----
# Freemium sur predicthq.com
PREDICTHQ_API_KEY=your_predicthq_key

# ---- RapidAPI / Booking.com (hôtels) ----
# Via rapidapi.com/apidojo/api/booking
RAPIDAPI_KEY=your_rapidapi_key

# ---- Google Places (activités) ----
# Via console.cloud.google.com
GOOGLE_PLACES_KEY=your_google_places_key

# ---- Frontend URL (pour CORS) ----
CLIENT_URL=http://localhost:3001
