# =============================================
# TRIPGENIE — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# Ne JAMAIS committer le .env sur GitHub !
# =============================================

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (génère avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Base de données PostgreSQL (connexion directe) ----
# Supabase : Settings > Database > Connection string > URI
# Format : postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Ou tout autre hébergeur PostgreSQL (Neon, Railway, Render...)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Claude / Anthropic ----
# Clé sur console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxx

# ---- Tavily (recherche web : vols, événements, hôtels) ----
# Gratuit sur tavily.com
TAVILY_API_KEY=tvly-xxxx

# ---- OpenRouter (provider IA alternatif — optionnel) ----
# Sur openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key

# ---- Unsplash (photos HD des destinations — optionnel) ----
# Clé gratuite sur unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ---- Frontend URL (pour CORS) ----
CLIENT_URL=http://localhost:3001

# https://www.eventbrite.com/account-settings/apps (Événements réels)
EVENTBRITE_API_KEY=your_eventbrite_private_token
